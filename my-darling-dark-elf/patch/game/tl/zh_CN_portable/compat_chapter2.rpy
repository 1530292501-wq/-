# game/chapter2.rpyc:1609
translate zh_CN_portable_compat chapter2_de921599_1:

    # Jenny "His work was amazing. It had a clear vision, and a goal it wanted to accomplish, while my work feels so derivative."
    Jenny "他的作品太棒了，有清晰的想法，也知道自己要表达什么。可我的画，总觉得没跳出别人的影子。"

