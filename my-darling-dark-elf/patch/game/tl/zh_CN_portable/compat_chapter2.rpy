# game/chapter2.rpyc:1709
translate zh_CN_portable_compat chapter2_5071d1ad_1:

    # Merel "Isn’t this crazy? It was lyin’ in such an inconspicuous place, too, on this shelf full of books about astrology."
    Merel "很离谱吧？居然塞在那么不起眼的地方，那架子上全是占星术的书。"

# game/chapter2.rpyc:1711
translate zh_CN_portable_compat chapter2_a52590f9_1:

    # Merel "I just wonder how it got there. Maybe somebody was playin’ a prank, wahaha."
    Merel "真不知道怎么跑到那里的。也许是谁在恶作剧，哇哈哈。"

# game/chapter2.rpyc:1715
translate zh_CN_portable_compat chapter2_5c66c0d0_1:

