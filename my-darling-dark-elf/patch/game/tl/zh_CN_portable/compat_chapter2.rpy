translate zh_CN_portable_compat chapter2_eab8f2c7_1:

    # Jenny "Why don’t you look around a bit? I’m sure you didn’t come here to listen to me!"
    Jenny "去四处看看吧？你肯定不是专程来听我唠叨的！"

# game/chapter2.rpyc:1626
translate zh_CN_portable_compat chapter2_2e5795d5_1:

    # Nienke "I’m the one who asked what you were doing, though. I’m decently interested..."
    Nienke "可本来就是我主动问的。我也挺感兴趣……"

